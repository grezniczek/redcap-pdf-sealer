{
    "name": "PDF Sealer",
    "namespace": "DE\\RUB\\PDFSealerExternalModule",
    "description": "Reference implementation of terminal PDF sealing through the REDCap PDF finalization pipeline.",
    "authors": [
        {
            "name": "Günther Rezniczek",
            "email": "guenther.rezniczek@rub.de",
            "institution": "Department of Gynecology and Obstetrics, Ruhr University Bochum, Marien Hospital Herne"
        }
    ],
    "framework-version": 16,
    "enable-no-auth-logging": true,
    "auth-ajax-actions": ["save_alert_recipients"],
    "pdf-finalize": [
        {
            "id": "seal",
            "purpose": "Apply a cryptographic document seal",
            "document_types": [
                "econsent"
            ],
            "is_terminal": true
        }
    ],
    "system-settings": [
        {
            "key": "admin-alert-recipients",
            "name": "PKI alarm email recipients",
            "tt_name": "admin_alert_recipients",
            "type": "email",
            "repeatable": true,
            "required": false
        }
    ],
    "links": {
        "control-center": [
            {
                "name": "PDF Seal PKI",
                "tt_name": "pki_link_name",
                "icon": "fas fa-lock",
                "url": "pki-admin.php",
                "show-header-and-footer": false
            }
        ]
    }
}
