{
    "name": "PDF Sealer",
    "namespace": "DE\\RUB\\PDFSealerExternalModule",
    "description": "Reference implementation of terminal PDF sealing through the REDCap PDF finalization pipeline.",
    "documentation": "README.md",
    "documentation-project": "docs/PROJECT.md",
    "documentation-system": "docs/ADMIN.md",
    "authors": [
        {
            "name": "Günther Rezniczek",
            "email": "guenther.rezniczek@rub.de",
            "institution": "St. Elisabethgruppe GmbH - Marien Hospital Herne | Klinikum der Ruhr-Universität Bochum"
        }
    ],
    "framework-version": 16,
    "compatibility": {
        "php-version-min": "8.2.0"
    },
    "enable-no-auth-logging": true,
    "enable-every-page-hooks-on-system-pages": true,
    "enable-every-page-hooks-on-login-form": true,
    "auth-ajax-actions": ["preview_tsa_lifecycle", "replace_tsa_certificate", "revoke_tsa_certificate", "preview_project_revocation", "revoke_project_certificate", "preview_project_renewal", "renew_project_certificate", "preview_provider_transition", "start_provider_transition", "cancel_provider_transition", "preview_ca_retirement", "set_ca_retirement", "review_project_certificate", "activate_project_certificate", "generate_project_csr", "download_project_csr", "cancel_project_csr", "save_assignment_policy", "register_ca_provider", "assign_ca_provider", "run_diagnostic", "send_test_alarm", "save_timestamp_settings",
        "register_timestamp_source",
        "test_timestamp_source",
        "save_provider_timestamp", "save_alert_recipients", "download_root_certificate", "download_public_root_certificate"],
    "no-auth-ajax-actions": ["download_public_root_certificate"],
    "crons": [
        {
            "cron_name": "certificate_maintenance",
            "cron_description": "Renew PDF Sealer built-in root, TSA and project certificates",
            "tt_cron_description": "maintenance_cron_description",
            "method": "maintainBuiltinCertificates",
            "cron_frequency": 3600,
            "cron_max_run_time": 300
        },
        {
            "cron_name": "certificate_expiry",
            "cron_description": "Check PDF Sealer certificate expiry and send advance alarms",
            "tt_cron_description": "expiry_cron_description",
            "method": "checkCertificateExpiry",
            "cron_frequency": 86400,
            "cron_max_run_time": 3600
        },
        {
            "cron_name": "certificate_crls",
            "cron_description": "Publish PDF Sealer built-in certificate revocation lists",
            "tt_cron_description": "crl_cron_description",
            "method": "publishCertificateRevocationLists",
            "cron_frequency": 86400,
            "cron_max_run_time": 300
        }
    ],
    "pdf-finalize": [
        {
            "id": "seal",
            "purpose": "Apply a cryptographic document seal",
            "document_types": [
                "econsent"
            ],
            "is_terminal": true
        }
    ],
    "project-settings": [
        {
            "key": "hide-project-trust-link",
            "name": "Hide the link to PDF Sealer root certificates in this project",
            "tt_name": "project_hide_trust_link",
            "type": "checkbox"
        }
    ],
    "system-settings": [
        {
            "key": "admin-alert-recipients",
            "name": "PKI alarm email recipients",
            "tt_name": "admin_alert_recipients",
            "type": "email",
            "repeatable": true,
            "required": false
        }
    ],
    "links": {
        "control-center": [
            {
                "name": "<b>PDF Sealer</b> &bull; Administration",
                "tt_name": "pki_link_name",
                "icon": "fas fa-lock",
                "url": "pki-admin.php",
                "show-header-and-footer": false
            }
        ],
        "project": [
            {
                "key": "public-trust",
                "name": "<b>PDF Sealer</b> &bull; Trust Certificates",
                "tt_name": "project_trust_link_name",
                "icon": "fas fa-certificate",
                "url": "project-trust-link.php",
                "target": "_blank",
                "show-header-and-footer": false
            },
            {
                "key": "project-status",
                "name": "<b>PDF Sealer</b> &bull; Status",
                "tt_name": "project_status_title",
                "icon": "fas fa-file-signature",
                "url": "project-status.php",
                "show-header-and-footer": false
            }
        ]
    }
}
