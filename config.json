{
    "name": "PDF Sealer",
    "namespace": "DE\\RUB\\PDFSealerExternalModule",
    "description": "Reference implementation of terminal PDF sealing through the REDCap PDF finalization pipeline.",
    "authors": [
        {
            "name": "Günther Rezniczek",
            "email": "guenther.rezniczek@rub.de",
            "institution": "St. Elisabethgruppe GmbH - Marien Hospital Herne | Klinikum der Ruhr-Universität Bochum"
        }
    ],
    "framework-version": 16,
    "enable-no-auth-logging": true,
    "enable-every-page-hooks-on-system-pages": true,
    "enable-every-page-hooks-on-login-form": true,
    "auth-ajax-actions": ["run_diagnostic", "save_timestamp_settings", "save_alert_recipients", "download_root_certificate", "download_public_root_certificate"],
    "no-auth-ajax-actions": ["download_public_root_certificate"],
    "pdf-finalize": [
        {
            "id": "seal",
            "purpose": "Apply a cryptographic document seal",
            "document_types": [
                "econsent"
            ],
            "is_terminal": true
        }
    ],
    "project-settings": [
        {
            "key": "hide-project-trust-link",
            "name": "Hide the link to PDF Sealer root certificates in this project",
            "tt_name": "project_hide_trust_link",
            "type": "checkbox"
        }
    ],
    "system-settings": [
        {
            "key": "admin-alert-recipients",
            "name": "PKI alarm email recipients",
            "tt_name": "admin_alert_recipients",
            "type": "email",
            "repeatable": true,
            "required": false
        }
    ],
    "links": {
        "control-center": [
            {
                "name": "PDF Sealer PKI",
                "tt_name": "pki_link_name",
                "icon": "fas fa-lock",
                "url": "pki-admin.php",
                "show-header-and-footer": false
            }
        ],
        "project": [
            {
                "key": "public-trust",
                "name": "PDF Sealer root certificates",
                "tt_name": "project_trust_link_name",
                "icon": "fas fa-certificate",
                "url": "project-trust-link.php",
                "target": "_blank",
                "show-header-and-footer": false
            },
            {
                "key": "project-status",
                "name": "PDF Sealer status",
                "tt_name": "project_status_title",
                "icon": "fas fa-file-signature",
                "url": "project-status.php",
                "show-header-and-footer": false
            }
        ]
    }
}
